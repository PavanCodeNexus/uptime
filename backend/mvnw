#!/bin/sh
# Apache Maven Wrapper (Unix/Docker)
set -e
MAVEN_VERSION="3.9.9"
DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
WRAPPER_DIR="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MVN_BIN="${WRAPPER_DIR}/apache-maven-${MAVEN_VERSION}/bin/mvn"

if [ ! -x "${MVN_BIN}" ]; then
  mkdir -p "${WRAPPER_DIR}"
  curl -fsSL "${DIST_URL}" | tar -xz -C "${WRAPPER_DIR}"
fi

exec "${MVN_BIN}" "$@"
