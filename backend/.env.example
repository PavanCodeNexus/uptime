# =============================================================================
# UPTIME Backend — Environment Variables Template (.env.example)
# Copy to .env and fill in real values. NEVER commit .env!
# =============================================================================

# Profile: dev | demo | prod
APP_ENV=dev
SERVER_PORT=8080

# Supabase PostgreSQL
DB_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# JWT RS256 Keys (Base64-encoded PKCS8 private key and X509 public key; optional in dev)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Upstash Redis (prod only; dev/demo uses in-memory cache)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# RabbitMQ (optional in dev; falls back to async executor)
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=uptime
RABBIT_PASSWORD=uptime

# Google Gemini 1.5 Flash AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Maps Platform
GOOGLE_MAPS_API_KEY=

# Razorpay Payment Gateway (use rzp_test_* in dev/demo)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS / OTP Gateway (prod only; dev/demo uses MockOtpProvider with 123456)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid Email
SENDGRID_API_KEY=
MAIL_FROM=noreply@uptime.in

# Agora.io Video Consultation (Wave 3)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
