{
  "name": "uptime-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "UPTIME web frontends (owner, technician, admin) and the shared package",
  "workspaces": [
    "apps/owner-web",
    "apps/tech-web",
    "apps/admin-web",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:owner": "npm run dev -w @uptime/owner-web",
    "dev:tech": "npm run dev -w @uptime/tech-web",
    "dev:admin": "npm run dev -w @uptime/admin-web",
    "build": "npm run build -w @uptime/owner-web -w @uptime/tech-web -w @uptime/admin-web",
    "typecheck": "npm run typecheck -w @uptime/shared -w @uptime/owner-web -w @uptime/tech-web -w @uptime/admin-web",
    "test": "npm run test -w @uptime/shared",
    "check:backend": "node packages/shared/scripts/check-backend.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
