# =============================================================================
# UPTIME Monorepo — .gitignore
# =============================================================================

# ── Environment & Secrets (NEVER COMMIT) ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json

# ── Backend (Spring Boot / Java / Maven) ─────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
!**/src/main/**/target/
!**/src/test/**/target/
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*
uploads/

# ── Frontend & Shared (React / Vite / TypeScript / Node) ─────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# ── Mobile (Flutter / Dart / Android / iOS) ──────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/android/**/gradle-wrapper.jar
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
*.jks
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/ServiceDefinitions.json
*.g.dart
*.freezed.dart

# ── IDEs & Editors ───────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.project
.classpath
.settings/

# ── OS & Miscellaneous ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.bak
*.swp
*~
